# ==============================================================================
# FormaCenter - Modèle d'environnement Monorepo (.env.example)
# RÈGLE ABSOLUE : Ne jamais renseigner de secrets réels ni d'accès de production.
# Copiez ce fichier vers .env à la racine : cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de données PostgreSQL locale (Développement uniquement)
# ------------------------------------------------------------------------------
# Hôte local strict (aucun accès distant)
DB_HOST=127.0.0.1

# Port standard du serveur PostgreSQL local
DB_PORT=5432

# Nom de la base de données locale dédiée au projet
DB_NAME=centerforma_dev

# Utilisateur PostgreSQL applicatif dédié créé par scripts/setup-db-dev.sql
DB_USER=centerforma_app

# Mot de passe fictif de l'utilisateur local (remplacez par votre mot de passe local)
DB_PASSWORD=votre_mot_de_passe_local_securise

# URL de connexion complète utilisée par Prisma ORM et les scripts Node.js
DATABASE_URL=postgresql://centerforma_app:votre_mot_de_passe_local_securise@127.0.0.1:5432/centerforma_dev?schema=public

# ------------------------------------------------------------------------------
# 2. Serveur Backend Nitro API (Node.js)
# ------------------------------------------------------------------------------
# Port d'écoute HTTP du serveur API Nitro (défaut : 3000)
PORT=3000
API_PORT=3000
NITRO_PORT=3000

# Mode d'exécution applicatif (development | production | test)
NODE_ENV=development

# Clé secrète fictive pour la signature des jetons JWT locaux (/api/auth/*)
JWT_SECRET=changez_cette_cle_secrete_jwt_pour_le_dev_local_123456

# Mot de passe initial du Super Administrateur créé par le script de seed
INITIAL_ADMIN_PASSWORD=Admin2026!LocalSecure

# ------------------------------------------------------------------------------
# 3. Serveur Frontend Web (Vite / TanStack Start)
# ------------------------------------------------------------------------------
# URL cible pour les appels API serveur (SSR / fonctions TanStack Start)
API_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Intégrations de transition Supabase (Stockage fichiers / Transition progressive)
# Ces valeurs sont utilisées pour le stockage d'avatars et de documents (Storage)
# et pour le pont d'authentification pendant la migration.
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_ID=dummy_supabase_project_id
SUPABASE_URL=https://dummy-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_publishable_key
VITE_SUPABASE_PROJECT_ID=dummy_supabase_project_id
VITE_SUPABASE_URL=https://dummy-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_publishable_key

# Clé service_role optionnelle : requise UNIQUEMENT si vous exportez depuis Supabase Cloud
# Ne jamais exposer dans le frontend ni commiter !
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_service_role_key

# ==============================================================================
# FormaCenter - Frontend Web (.env.example)
# RÈGLE ABSOLUE : Valeurs fictives de développement uniquement.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configuration des appels API Backend Nitro
# ------------------------------------------------------------------------------
# En développement dans le navigateur : les requêtes /api sont automatiquement
# redirigées vers http://localhost:3000 par le proxy Vite (vite.config.ts).
# Côté serveur Node.js (SSR / fonctions TanStack Start) : URL explicite du backend Nitro.
API_BASE_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Transition & Intégration Supabase (Stockage fichiers & authentification résiduelle)
# Ces valeurs sont requises pour initialiser le client Supabase (@supabase/supabase-js)
# utilisé pour l'upload d'avatars et de documents (Storage buckets : avatars, documents).
# ------------------------------------------------------------------------------
SUPABASE_PROJECT_ID=dummy_supabase_project_id
SUPABASE_URL=https://dummy-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_publishable_key
VITE_SUPABASE_PROJECT_ID=dummy_supabase_project_id
VITE_SUPABASE_URL=https://dummy-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_publishable_key

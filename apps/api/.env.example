# ==============================================================================
# FormaCenter - Backend Nitro API (.env.example)
# RÈGLE ABSOLUE : Valeurs fictives de développement uniquement.
# ==============================================================================

# Serveur Nitro API (Port local 3000)
PORT=3000
NITRO_PORT=3000
API_PORT=3000
NODE_ENV=development

# Clé secrète de signature JWT locale
JWT_SECRET=changez_cette_cle_secrete_jwt_pour_le_dev_local_123456

# Base de données PostgreSQL Locale
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=centerforma_dev
DB_USER=centerforma_app
DB_PASSWORD=votre_mot_de_passe_local_securise
DATABASE_URL=postgresql://centerforma_app:votre_mot_de_passe_local_securise@127.0.0.1:5432/centerforma_dev?schema=public

# Mot de passe Super Administrateur de seed initial
INITIAL_ADMIN_PASSWORD=Admin2026!LocalSecure

# Intégrations de transition (pont de fallback vers Supabase)
SUPABASE_URL=https://dummy-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy_anon_publishable_key


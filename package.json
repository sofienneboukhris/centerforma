{
  "name": "centerforma-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"web,api\" -c \"blue,green\" \"npm run dev --workspace=@centerforma/web\" \"npm run dev --workspace=@centerforma/api\"",
    "dev:web": "npm run dev --workspace=@centerforma/web",
    "dev:api": "npm run dev --workspace=@centerforma/api",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@centerforma/web",
    "build:api": "npm run build --workspace=@centerforma/api",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace=@centerforma/web",
    "test:api": "npm run test --workspace=@centerforma/api",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "db:generate": "npm run db:generate --workspace=@centerforma/api",
    "db:migrate": "npm run db:migrate --workspace=@centerforma/api",
    "db:push": "npm run db:push --workspace=@centerforma/api",
    "db:studio": "npm run db:studio --workspace=@centerforma/api",
    "migration": "node scripts/migration/run-migration.mjs",
    "migration:check": "node scripts/migration/run-migration.mjs --check",
    "migration:seed": "node scripts/migration/run-migration.mjs --seed",
    "migration:verify": "node scripts/migration/run-migration.mjs --verify",
    "backup:verify": "node scripts/verify-backup-restore.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "concurrently": "^9.1.2"
  }
}
